<!--
  Back button that replaces the Toolbar's own navigation icon in the Expressive header. It is a
  sibling of the Toolbar (not a child) so it can glide through the extended header like the other
  toolbar buttons and still receive touches. CollapsingToolbarDelegate wires it to the Toolbar's
  navigation click.
-->
<ImageButton
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_back_button"
    android:layout_width="wrap_content"
    android:layout_height="?attr/actionBarSize"
    android:layout_gravity="top|start"
    android:layout_marginStart="@dimen/settingslib_expressive_space_extrasmall4"
    android:paddingStart="@dimen/settingslib_expressive_space_extrasmall4"
    android:minWidth="48dp"
    android:background="@null"
    android:scaleType="center"
    android:src="@drawable/settingslib_expressive_icon_back"
    app:layout_collapseMode="pin" />
